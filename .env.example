cat > .env.example << 'EOF'
# Banco de dados
DB_USER=
DB_PASSWORD=

# Google Gemini (Assistente IA) - gere em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Segredo da sessao (min. 32 caracteres) - gere com: openssl rand -base64 32
SESSION_SECRET=

# Token da API do estoque (mesmo valor nas duas) - gere com: openssl rand -hex 24
API_ESTOQUE_TOKEN=
NEXT_PUBLIC_API_ESTOQUE_TOKEN=
EOF